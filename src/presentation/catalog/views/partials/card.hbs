<article {{#if anchorId}}id="{{anchorId}}" tabindex="-1" data-shared-product{{/if}} {{#if @root.visualPreview}}data-editor-path="source.products.{{@index}}"{{/if}} class="catalog-card" data-catalog-card data-card-bootstrap="{{bootstrap}}">
  <div class="catalog-image{{#if illustration}} is-illustration{{/if}}">
    <span class="catalog-discount-ribbon" data-card-discount aria-label="{{discountPercent}}% de descuento en la opción seleccionada" {{#unless discountPercent}}hidden{{/unless}}>{{#if discountPercent}}{{discountPercent}}% OFF{{/if}}</span>
    {{#if sharePath}}<details class="catalog-share" data-product-share data-share-path="{{sharePath}}" data-share-name="{{name}}" data-share-origin="{{@root.seo.origin}}">
      <summary aria-label="Compartir {{name}}" title="Compartir artículo"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="6" cy="12" r="3"/><circle cx="18" cy="5" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 10.5 6.8-4m-6.8 7 6.8 4"/></svg></summary>
      <div class="catalog-share-panel">
        <strong>Compartir artículo</strong>
        <div data-share-actions hidden>
          <a data-share-whatsapp href="{{sharePath}}" target="_blank" rel="noopener noreferrer"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 3.5A11.8 11.8 0 0 0 12 0 11.9 11.9 0 0 0 1.7 18l-1.7 6 6.2-1.6A12 12 0 0 0 12 24h.1A12 12 0 0 0 24 12a11.8 11.8 0 0 0-3.5-8.5ZM12.1 22a10 10 0 0 1-5.1-1.4l-.4-.2-3.7 1 1-3.6-.3-.4A10 10 0 1 1 12.1 22Zm5.4-7.5c-.3-.1-1.8-.9-2-.9s-.5-.1-.7.2-.8.9-1 1-.3.2-.6 0a8.1 8.1 0 0 1-2.3-1.4 8.7 8.7 0 0 1-1.6-2c-.2-.3 0-.4.1-.6l.5-.5.3-.5c.1-.1 0-.3 0-.5l-1-2.2c-.2-.6-.5-.5-.7-.5H8c-.2 0-.5.1-.8.4s-1 1-1 2.4 1 2.7 1.2 2.9 2.1 3.3 5.1 4.6c.7.3 1.3.5 1.7.6.7.2 1.3.2 1.8.1.5-.1 1.8-.7 2-1.4s.3-1.3.2-1.4-.3-.2-.6-.3Z"/></svg><span>WhatsApp</span></a>
          <button type="button" data-share-instagram><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.1"/><circle cx="17.4" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg><span>Instagram</span></button>
          <button type="button" data-share-copy><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m8 6-6 6 6 6m8-12 6 6-6 6m-2-14-4 16"/></svg><span>Copiar enlace</span></button>
          <p data-share-status role="status" aria-live="polite"></p>
          <label data-share-fallback hidden>Enlace del artículo<input data-share-url type="text" readonly aria-label="Enlace del artículo"></label>
        </div>
        <a data-share-basic href="{{sharePath}}">Abrir enlace del artículo</a>
      </div>
    </details>{{/if}}
    <a class="catalog-card-info" data-card-info href="{{href}}" aria-label="Información de {{name}}" title="Información del producto"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 11v5m0-9v1"/></svg></a>
    {{#if zoomImage}}<a class="catalog-photo-zoom" data-card-zoom data-zoom-name="{{name}}" href="{{zoomImage}}" aria-label="Ampliar imagen de {{name}}"><span aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6M7 10h6m-3-3v6"/></svg></span></a>{{/if}}
    {{#if carousel}}
      {{#each gallery}}<img data-card-image data-zoom-src="{{zoom}}" src="{{url}}" srcset="{{srcset}}" sizes="(min-width: 1024px) 31vw, (min-width: 600px) 47vw, 92vw" alt="" loading="lazy" decoding="async" {{#unless first}}hidden{{/unless}}>{{/each}}
    {{else if image}}
      <img data-card-image data-zoom-src="{{zoomImage}}" src="{{image}}" {{#if imageSrcset}}srcset="{{imageSrcset}}" sizes="(min-width: 1024px) 31vw, (min-width: 600px) 47vw, 92vw"{{/if}} alt="" loading="lazy" decoding="async">
    {{/if}}
    <span class="catalog-placeholder" data-card-placeholder {{#if image}}hidden{{else}}{{#if carousel}}hidden{{/if}}{{/if}} role="img" aria-label="Imagen no disponible">Imagen no disponible</span>
    {{#if carousel}}<div class="catalog-carousel" data-card-controls hidden>
      <button type="button" data-card-previous aria-label="Imagen anterior de {{name}}"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
      <button type="button" data-card-next aria-label="Imagen siguiente de {{name}}"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
      <span data-card-position class="sr-only" aria-live="polite"></span>
    </div>{{/if}}
    {{#if illustration}}<span class="catalog-illustration">Imagen ilustrativa</span>{{/if}}
  </div>
  <div class="catalog-card-copy">
    {{#if categoryName}}<p class="catalog-card-category">{{categoryName}}</p>{{/if}}
    <h3><a data-card-link class="catalog-card-link" href="{{href}}">{{name}}</a></h3>
    {{#if dimensions}}<p class="catalog-card-dimensions">{{#each dimensions}}<span class="catalog-card-dimension" title="{{label}}: {{value}}"><svg class="catalog-dimension-icon catalog-dimension-icon-{{axis}}" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h16m-4-4 4 4-4 4M8 8l-4 4 4 4"/></svg><span class="sr-only">{{label}}: </span>{{value}}</span>{{/each}}</p>{{/if}}
    <div class="catalog-options" data-card-options hidden></div>
    <div class="catalog-buy-row">
      <p class="catalog-price" data-card-price data-price-state="{{priceState}}" aria-live="polite">{{#if regularPrice}}<del class="product-regular-price" aria-label="Precio habitual: {{regularPrice}}">{{regularPrice}}</del> <span aria-label="Precio en descuento: {{price}}">{{price}}</span>{{else}}{{price}}{{/if}}</p>
      <div data-card-purchase hidden><button type="button" class="catalog-add" data-card-add disabled>Agregar</button></div>
    </div>
    <p class="catalog-card-feedback" data-card-status role="status"></p>
    <p class="catalog-card-feedback catalog-card-error" data-card-error role="alert" hidden></p>
    {{#if description}}
      <div class="catalog-card-summary">
        <p class="catalog-card-description">{{description}}</p>
        <a {{#if @root.visualPreview}}data-editor-path="listing.moreLabel"{{/if}} class="catalog-card-more" data-card-more href="{{href}}" aria-label="{{#if @root.listing}}{{@root.listing.moreLabel}}{{else}}Ver más{{/if}} sobre {{name}}">{{#if @root.listing}}{{@root.listing.moreLabel}}{{else}}Ver más{{/if}}</a>
      </div>
    {{/if}}
    <noscript><small>Elegí opciones y consultá los detalles en la ficha del producto.</small></noscript>
  </div>
</article>
