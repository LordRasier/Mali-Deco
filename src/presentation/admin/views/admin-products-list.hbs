<section class="admin-main product-list" data-admin-section="products" data-product-view="list" data-product-page="{{page}}" data-product-search="{{search}}" data-product-status-filter="{{listStatus}}" data-product-sort="{{listSort}}" aria-label="Productos">
  <div class="section-heading product-list-heading"><div><span class="eyebrow">Catálogo</span><h1>Productos</h1><p>Precios, disponibilidad y publicación de tus artículos.</p></div><button class="primary" type="button" data-product-action="create"><span aria-hidden="true">＋</span> Agregar producto</button></div>
  <p data-product-message class="notice error" role="alert" hidden></p><p data-product-loading role="status" hidden>Cargando productos.</p>
  <button type="button" data-product-action="retry" hidden>Reintentar lectura</button>
  <form class="product-list-toolbar" data-product-search-form role="search" aria-label="Buscar y filtrar productos">
    <label class="product-search">Buscar productos<span class="product-search-control"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg><input type="search" name="search" maxlength="100" value="{{search}}" placeholder="Buscar por nombre o SKU"></span></label>
    <label>Estado<select name="status">{{#each statusOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label>Ordenar<select name="sort">{{#each sortOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <button type="submit" class="product-filter-button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M7 12h10M10 17h4"/></svg> Aplicar</button>
  </form>
  <div class="product-list-meta"><div class="product-list-count" aria-live="polite"><strong>{{total}}</strong> {{#if filtered}}{{#if singleResult}}resultado{{else}}resultados{{/if}}{{else}}{{#if singleResult}}producto{{else}}productos{{/if}} en total{{/if}}</div>{{#if hasFilters}}<button type="button" class="link-button" data-product-action="clear-filters">Limpiar filtros</button>{{/if}}</div>
  <div class="panel product-list-panel">
    {{#if items}}<div class="table-scroll"><table class="data-table product-table"><thead><tr><th scope="col">Producto</th><th scope="col">Stock</th><th scope="col">Precio</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead><tbody>
      {{#each items}}<tr data-product-row="{{id}}">
        <td><div class="product-list-identity"><button type="button" class="product-thumbnail" data-product-action="detail" data-product-id="{{id}}" aria-label="Ver detalle de {{name}}"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="15" rx="2"/><circle cx="8" cy="10" r="1.5"/><path d="m4 18 5-5 3 3 3-4 5 6"/></svg>{{#if imageUrl}}<img src="{{imageUrl}}" alt="" width="64" height="64" loading="lazy" decoding="async" data-product-thumbnail>{{/if}}</button><div class="product-list-name"><button type="button" class="link-button product-name-link" data-product-action="detail" data-product-id="{{id}}">{{name}}</button><small>{{#if sku}}SKU: {{sku}}{{else}}{{#if variantLabel}}{{variantLabel}}{{else}}{{slug}}{{/if}}{{/if}}</small></div></div></td>
        <td data-product-summary="stock"><span class="product-stock {{#if outOfStock}}product-stock-empty{{/if}}">{{stockLabel}}</span>{{#if availability}}<small class="product-cell-note">{{availability}}</small>{{/if}}</td>
        <td data-product-summary="price"><strong class="product-price">{{priceLabel}}</strong>{{#if currency}}<small class="product-cell-note">{{currency}}</small>{{/if}}</td>
        <td><span class="product-status" data-product-status="{{statusKey}}">{{statusLabel}}</span></td>
        <td><div class="product-row-actions">{{#unless archived}}<button type="button" class="product-icon-button product-quick-toggle" data-quick-toggle="{{id}}" aria-label="Ajuste rápido de {{name}}" title="Ajustar precio y stock" aria-expanded="false" aria-controls="quick-product-{{id}}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>{{/unless}}{{#if publicUrl}}<a class="product-icon-button" href="{{publicUrl}}" target="_blank" rel="noopener noreferrer" aria-label="Ver {{name}} en la tienda" title="Ver en la tienda"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6M20 4 10 14M11 5H5v14h14v-6"/></svg></a>{{/if}}<button type="button" class="product-icon-button" data-product-action="detail" data-product-id="{{id}}" aria-label="{{#if archived}}Ver{{else}}Editar{{/if}} {{name}}" title="{{#if archived}}Ver detalle{{else}}Editar producto{{/if}}"><svg viewBox="0 0 24 24" aria-hidden="true">{{#if archived}}<path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>{{else}}<path d="m15 4 5 5M4 20l5-1L20 8a2 2 0 0 0-5-5L4 14v6Z"/>{{/if}}</svg></button></div></td>
      </tr>
      <tr class="product-quick-row" data-quick-row="{{id}}" id="quick-product-{{id}}" hidden><td colspan="5"><div class="product-quick-panel"><p data-quick-notice role="status"></p><div data-quick-content></div></div></td></tr>{{/each}}
    </tbody></table></div>{{else}}<div class="product-list-empty">{{#if total}}<strong>No hay productos en esta página.</strong><p>Volvé a la página anterior para continuar.</p>{{else}}{{#if hasFilters}}<strong>No encontramos productos para estos filtros.</strong><p>Probá con otro nombre, SKU o estado.</p>{{else}}<strong>Todavía no hay productos.</strong><p>Creá el primero para empezar a completar tu catálogo.</p><button type="button" class="primary" data-product-action="create">＋ Agregar producto</button>{{/if}}{{/if}}</div>{{/if}}
    <nav class="pagination product-list-pagination" aria-label="Paginación de productos"><span>{{#if items}}Mostrando {{firstItem}}–{{lastItem}} de {{total}} · {{/if}}Página {{page}} de {{pages}}</span><div>
      <button type="button" data-product-action="page" data-product-page="{{previousPage}}" {{#unless hasPrevious}}disabled{{/unless}}>Anterior</button>
      <button type="button" data-product-action="page" data-product-page="{{nextPage}}" {{#unless hasNext}}disabled{{/unless}}>Siguiente</button>
    </div></nav>
  </div>
</section>
