<dialog id="cart-dialog" class="cart-drawer" aria-labelledby="cart-title" data-cart-dialog>
  <header class="cart-drawer-header">
    <h2 id="cart-title">Tu carrito</h2>
    <button type="button" class="cart-close" data-cart-close autofocus aria-label="Cerrar carrito">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="m6 6 12 12M6 18 18 6"/></svg>
    </button>
  </header>
  <div data-cart-content>
    <p class="cart-feedback" data-cart-warning role="status" hidden></p>
    <p class="cart-feedback" data-cart-status role="status">Cargando carrito…</p>
    <button type="button" data-cart-retry hidden>Volver a verificar</button>
    <p data-cart-announcement class="sr-only" aria-live="polite"></p>
    <div class="cart-empty" data-cart-empty hidden>
      <div class="cart-empty-icon" aria-hidden="true"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M5 7h14l1 14H4L5 7Z"/><path d="M8 8V6a4 4 0 0 1 8 0v2"/></svg></div>
      <h3>Tu carrito está vacío</h3>
      <p>Encuentra algo que le dé otra forma a tu espacio.</p>
      <a class="cart-primary" href="{{routes.catalog}}" data-cart-empty-focus>Explorar productos</a>
    </div>
    <div class="cart-filled" data-cart-filled hidden>
      <section class="cart-items" aria-label="Artículos del carrito">
        <p class="cart-meta" data-cart-count></p>
        <ul data-cart-list></ul>
        <section class="cart-shipping" aria-labelledby="cart-shipping-title">
          <div class="cart-shipping-top">
            <div class="cart-shipping-heading"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 5h11v12H3zM14 9h4l3 4v4h-7"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg><h3 id="cart-shipping-title">Envío</h3></div>
            <div class="cart-postal-field"><label for="mvc-postal">Código postal</label><div class="cart-postal-controls" data-shipping-controls><input class="cart-postal-input" id="mvc-postal" data-shipping-postal autocomplete="postal-code" inputmode="numeric" maxlength="16" placeholder="Ej. 7600" aria-describedby="mvc-postal-error cart-shipping-message"><button class="cart-shipping-calculate" type="button" data-shipping-retry disabled>Calcular</button></div></div>
          </div>
          <p id="mvc-postal-error" data-shipping-error role="alert" hidden>Ingresa los cuatro números de tu código postal.</p>
          <div data-shipping-candidates-box hidden><label for="mvc-locality">Localidad</label><select id="mvc-locality" data-shipping-candidates><option value="">Elige tu localidad</option></select></div>
          <p id="cart-shipping-message" data-shipping-message role="status">Ingresa tu código postal para calcular el envío.</p>
          <fieldset class="cart-shipping-options" data-shipping-options hidden><legend class="sr-only">Medios de envío</legend></fieldset>
        </section>
      </section>
      <aside class="cart-summary" aria-labelledby="summary-title">
        <h3 id="summary-title">Resumen</h3>
        <dl class="cart-subtotals" data-cart-totals></dl>
        <dl class="cart-estimate" aria-live="polite"><dt>Envío estimado</dt><dd data-shipping-amount>A calcular</dd><dt class="cart-grand-total">Total estimado</dt><dd class="cart-grand-total" data-shipping-total>A calcular</dd></dl>
        {{#if checkoutEnabled}}<p class="cart-limitations">Prueba local: no se realizarán cobros ni se generarán envíos.</p>{{else}}<p class="cart-limitations"><strong>Por ahora, los pedidos se gestionan por Instagram.</strong> Pronto habilitaremos los pagos en línea.</p>{{/if}}
        <div class="cart-summary-actions">
          {{#if checkoutEnabled}}<a class="cart-primary" href="/checkout" data-cart-checkout>Continuar al checkout</a>{{/if}}
          <a class="cart-secondary" href="{{routes.catalog}}">Volver al catálogo</a>
        </div>
      </aside>
    </div>
  </div>
</dialog>
