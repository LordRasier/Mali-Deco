<!doctype html>
<html lang="es">
<head>
  <link rel="icon" type="image/png" href="/api/v1/catalog/branding/icon">
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  {{> seo_head}}
  <link rel="stylesheet" href="/assets/storefront/cart.css"><link rel="stylesheet" href="/assets/storefront/product.css">
  <link rel="stylesheet" href="/assets/storefront/shell.css">
  <script src="/assets/storefront/generated/cart.js" defer></script>
  <link rel="stylesheet" href="{{#if appearancePreviewHref}}{{appearancePreviewHref}}{{else}}/api/v1/catalog/theme.css{{/if}}">
</head>
<body>
  <a class="skip-link" href="#main">Ir al contenido</a>
  {{> site_header}}
  <main id="main" class="product-layout" tabindex="-1" data-cart-mode="{{mode}}" data-product-base="{{routes.product}}" {{#if ready}}data-product-bootstrap="{{bootstrap}}"{{/if}}>
    <nav aria-label="Ubicación"><a href="{{routes.home}}">Inicio</a> / <a href="{{routes.catalog}}">Objetos</a> / {{#if categoryHref}}<a href="{{categoryHref}}">{{categoryName}}</a> / {{/if}}{{title}}</nav>
    {{#if ready}}
    <div class="product-layout-grid">
      <section data-product-gallery aria-label="Imágenes del producto">
        {{#each images}}<img data-product-image data-image-id="{{id}}" src="{{url}}" {{#if srcset}}srcset="{{srcset}}" sizes="(max-width:760px) 100vw, 60vw"{{/if}} alt="{{alt}}" {{#unless first}}hidden{{/unless}}>{{/each}}
        <div data-gallery-placeholder class="product-image-placeholder" role="img" aria-label="Imagen no disponible" {{#if images}}hidden{{/if}}>Imagen no disponible</div>
        {{#if moreImages}}<div class="gallery-controls" role="group" aria-label="Controles de imágenes"><button type="button" data-gallery-previous disabled aria-label="Imagen anterior">Anterior</button><span data-gallery-position aria-live="polite"></span><button type="button" data-gallery-next disabled aria-label="Imagen siguiente">Siguiente</button></div>{{/if}}
        {{#if moreImages}}<div class="gallery-thumbnails" role="group" aria-label="Elegir imagen">{{#each images}}<button type="button" data-gallery-thumb disabled aria-label="Ver imagen {{position}}" aria-pressed="{{#if first}}true{{else}}false{{/if}}"><img src="{{url}}" alt="" loading="lazy"></button>{{/each}}</div>{{/if}}
        {{#each images}}{{#if illustration}}<p data-gallery-illustration>Imagen ilustrativa generada; no representa necesariamente la variante seleccionada.</p>{{/if}}{{/each}}
      </section>
      <section class="product-details" aria-labelledby="product-title">
        <p class="eyebrow">{{copy.product.eyebrow}}</p><h1 id="product-title">{{name}}</h1>
        <p data-product-price>{{#if regularPriceLabel}}<del class="product-regular-price" aria-label="Precio habitual: {{regularPriceLabel}}">{{regularPriceLabel}}</del> {{/if}}{{priceLabel}}{{#if demo}} · precio de ejemplo{{/if}}</p>
        <p class="product-discount-label" data-product-discount {{#unless discountPercent}}hidden{{/unless}}>{{#if discountPercent}}{{discountPercent}}% OFF{{/if}}</p>
        <p class="product-description">{{description}}</p>
        <p>Variante: <strong data-product-selected>{{selectedName}}</strong></p>
        <p data-product-availability>{{availability}}</p>
        <div data-product-variants role="group" aria-label="Variantes disponibles">{{#each variants}}<button type="button" data-product-variant="{{id}}" disabled>{{name}}</button>{{/each}}</div>
        {{#unless hasVariants}}<p>No hay variantes disponibles.</p>{{/unless}}
        {{#unless cartDisabled}}<p data-product-warning role="alert" hidden></p><p data-product-status role="status">Verificando variante…</p>
        <button type="button" data-product-retry hidden>Reintentar verificación</button>
        <button type="button" data-product-more hidden>Mostrar más variantes</button>
        <p data-product-page-error role="alert" hidden></p>
        <button type="button" data-product-page-retry hidden>Reintentar carga</button>
        <button type="button" data-product-reset hidden>Reiniciar carga</button>
        {{#unless cartDisabled}}<button type="button" data-product-add disabled>Agregar al carrito ↗</button>{{/unless}}
        {{/unless}}<section class="product-dimensions" aria-labelledby="product-dimensions-title"><h2 id="product-dimensions-title">Medidas del producto</h2><dl><div><dt>Ancho</dt><dd>{{dimensions.width}}</dd></div><div><dt>Alto</dt><dd>{{dimensions.height}}</dd></div><div><dt>Largo</dt><dd>{{dimensions.length}}</dd></div></dl></section>
        {{#if variantSummary}}<details class="product-variant-summary"><summary>Precios y disponibilidad de las opciones</summary><ul>{{#each variantSummary}}<li><a href="{{href}}">{{name}}</a>: {{price}} · {{availability}}</li>{{/each}}</ul></details>{{/if}}
        {{#unless cartDisabled}}<p class="product-order-note">{{copy.product.orderNote}}</p>{{/unless}}
        <noscript>La selección de variantes y el carrito necesitan JavaScript. No se agregó ningún artículo.</noscript>
      </section>
    </div>
    {{else}}<h1>{{title}}</h1><p role="alert">{{message}}</p>{{#if retry}}<a href="">Reintentar</a> · {{/if}}<a href="{{routes.catalog}}">Volver al catálogo</a>{{/if}}
  </main>
  {{> site_footer}}
  {{> cart_panel}}
</body>
</html>
