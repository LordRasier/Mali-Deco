# Ejemplo de configuración local. Exportar a cada proceso: no se carga automáticamente.
# La API inicia sin persistencia fuera de producción si DB_HOST está vacío.
PORT=3001
ADMIN_ORIGIN=http://localhost:3000
# Para conectar una base de desarrollo aislada, completar TODAS las variables:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=replace_me
# DB_PASSWORD=replace_me
# DB_DATABASE=replace_me
# Para el frontend, elegir API real O modo demo de desarrollo:
API_BASE_URL=http://localhost:3001/api/v1/
# STOREFRONT_MODE=demo
# DEV_API_PROXY_ORIGIN=http://127.0.0.1:3001
# STORE_NAME=Tienda
