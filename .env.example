# npm run dev lee .env desde la raíz. Copiar este ejemplo y completar la base autorizada.
# Las variables ya exportadas tienen prioridad. npm start/producción no leen .env.
PORT=3000
ADMIN_ORIGIN=http://127.0.0.1:3000
NODE_ENV=development
# Production canonical origin (leave unset for local development):
# PUBLIC_SITE_URL=https://mali-store.com.ar
# El catálogo público usa únicamente la base configurada; no existe selector de modo.
# Fuera de producción se permite iniciar sin persistencia si DB_HOST no está definido.
# Para una base autorizada, completar TODAS las variables:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=replace_me
# DB_PASSWORD=replace_me
# DB_DATABASE=replace_me
# Solo para una cuenta local sin contraseña previamente confirmada:
# DB_ALLOW_EMPTY_PASSWORD=1
# La tienda no expone checkout; las estimaciones del carrito son independientes.
LOCAL_TEST_CHECKOUT_ENABLED=false
# ZIPNOVA_OPERATOR_ORIGIN=http://127.0.0.1:3000
# Proveedores desactivados por defecto; leer la documentación antes de habilitarlos.
# Para estimaciones locales: DB autorizada y configuración privada
# ZIPNOVA_ENABLED=true, ZIPNOVA_OPERATOR_ORIGIN, ZIPNOVA_ACCOUNT_ID, ZIPNOVA_ORIGIN_ID,
# ZIPNOVA_CURRENCY, ZIPNOVA_CURRENCY_EXPONENT, ZIPNOVA_API_TOKEN y ZIPNOVA_API_SECRET.
# No guardar credenciales aquí. Ver docs/zipnova-quote-foundation.md.
# npm run dev puede leer solo token/secret de un archivo privado externo cuando
# NODE_ENV=development y ZIPNOVA_ENABLED=true. No activa checkout ni modifica otros valores.
# ZIPNOVA_ENV_FILE=C:/ruta/privada/zipnova.env
# El estimador no requiere ZIPNOVA_LOGISTICS_VALIDATED; el checkout conserva ese control.

# Optional local Mercado Pago TEST flow. Disabled by default; never use a real seller.
# Requires development + LOCAL_TEST_CHECKOUT_ENABLED, the authored payment migration,
# a verified MLA test seller, and a user-controlled public HTTPS return page.
# Credentials and migration execution require separate explicit authorization.
MERCADOPAGO_TEST_ENABLED=false
MERCADOPAGO_TEST_ACCESS_TOKEN=
MERCADOPAGO_TEST_SELLER_ID=
MERCADOPAGO_TEST_RETURN_URL=
# S2S payment notifications. HTTPS URL controlled by the store, pointing at:
# /api/v1/payments/mercadopago/webhook (no browser/customer cookie required).
# Secret from the application Webhooks panel; never commit the actual value.
MERCADOPAGO_WEBHOOK_URL=
MERCADOPAGO_WEBHOOK_SECRET=
# npm run dev can read only token and webhook secret from this ignored private file.
# MERCADOPAGO_ENV_FILE=.env.mercadopago.local
# Optional ingress for an HTTPS tunnel: exposes only webhook + /payments/return.
# Never point the tunnel at PORT (the full application).
LOCAL_PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY_PORT=3001

# Public store information. Fill only data intended to appear on the storefront.
# Initial fallback. Admin > Contenido y footer overrides these without restarting.
STORE_CONTACT_EMAIL=
# Initial fallback only. Admin > Settings overrides these; saving blank hides the icon.
STORE_WHATSAPP_NUMBER=
STORE_INSTAGRAM_USERNAME=
STORE_CONTACT_HOURS=
STORE_LEGAL_NAME=
STORE_CUIT=
STORE_LEGAL_ADDRESS=
# Official HTTPS URL provided by ARCA. Never paste HTML or credentials here.
STORE_DATA_FISCAL_URL=

# Transactional order emails. Apply migration:order-emails before enabling.
# disabled: previews only; test: redirect new notifications to ORDER_EMAIL_TEST_TO;
# live: real customers (orders marked testLocal are always skipped).
ORDER_EMAIL_MODE=disabled
ENVIALOSIMPLE_API_KEY=
# Local development only. Raw private key, ignored by Git. Production uses the variable above.
ENVIALOSIMPLE_API_KEY_FILE=
ORDER_EMAIL_FROM=
# Optional real mailbox for replies. The sending API does not create a mailbox.
ORDER_EMAIL_REPLY_TO=
ORDER_EMAIL_TEST_TO=
ORDER_EMAIL_SITE_URL=
